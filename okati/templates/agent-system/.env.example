# Copy this file to .env in the same folder, then fill in the values.
# .env is in .gitignore. Do not commit it.

# Model provider: openai or anthropic. If empty, okati uses openai when
# only OPENAI_API_KEY has a value.
AGENT_PROVIDER=openai

# OpenAI: the API key and the model name from your OpenAI account.
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic: use these instead if AGENT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# auto | mock | live. auto uses live only when the provider key has a value.
# Tests always use mock.
AGENT_MODE=auto

# Use a port from 3000 to 3999.
PORT=3100
