# Copy this file to .env in the same folder, then fill in the values.
# .env is in .gitignore. Do not commit it. Values set in the shell win.

# Model provider.
AGENT_PROVIDER=openai

# OpenAI: the API key and the model name from your OpenAI account.
OPENAI_API_KEY=
OPENAI_MODEL=

# auto | mock | live. auto uses live only when OPENAI_API_KEY has a value.
# Tests always use mock.
AGENT_MODE=auto

# Use a port from 3000 to 3999.
PORT=3100
