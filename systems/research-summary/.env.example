# Copy this file to .env in the same folder, then fill in the values.
# .env is in .gitignore. Do not commit it.

# Port from 3000 to 3999.
PORT=3217

# auto, mock or live. auto uses live only when the provider key has a value.
# Tests and the localhost run always use mock.
AGENT_MODE=auto

# Needed only in live mode. Do not commit a value.
ANTHROPIC_API_KEY=
# Model for live mode.
AGENT_MODEL=claude-sonnet-5-5

# Optional: lib/llm.js also supports OpenAI in live mode.
AGENT_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=

# fake or http. Tests and the localhost run use fake.
SEARCH_ADAPTER=fake

# Needed only for the http adapter.
WEB_SEARCH_URL=
# Needed only for the http adapter. Do not commit a value.
WEB_SEARCH_KEY=
# Needed only for the http adapter.
ENCYCLOPEDIA_URL=
# Needed only for the http adapter.
PAPERS_URL=
# Needed only for the http adapter. Do not commit a value.
PAPERS_KEY=
