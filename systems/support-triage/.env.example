# Copy to .env or export in the shell. Do not commit values.
# Leave ANTHROPIC_API_KEY empty to use the mock model with test data.
ANTHROPIC_API_KEY=
# auto | mock | live. auto uses live only when ANTHROPIC_API_KEY has a value.
AGENT_MODE=auto
AGENT_MODEL=claude-sonnet-5-5
# Use a port from 3000 to 3999.
PORT=3100
